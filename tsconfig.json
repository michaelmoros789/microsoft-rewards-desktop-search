{
  "compilerOptions": {
    "lib": ["DOM", "ES2020"],
    "module": "node16",
    "target": "ES2022",
    "moduleResolution": "node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
  },
  "include": ["src"]
}