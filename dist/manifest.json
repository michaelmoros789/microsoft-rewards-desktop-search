{
  "manifest_version": 3,
  "name": "Microsoft Rewards Bookmark Manager",
  "version": "1.0.1",
  "description": "Automate Microsoft Rewards by creating and managing Bing search bookmarks with unique keywords. Features configurable timing, progress tracking, and safe operation.",
  "permissions": [
    "storage",
    "tabs",
    "bookmarks",
    "alarms"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "https://www.bing.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Microsoft Rewards Bookmark Manager",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "author": "michaelmoros09",
  "homepage_url": "https://github.com/michaelmoros09/microsoft-rewards-desktop-search",
  "minimum_chrome_version": "88"
}